# Backend core
APP_ENV=local
APP_VERSION=1.0.0
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ai_visibility
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=ait:local
FRONTEND_URL=http://localhost:3000
WORKER_MAX_JOBS=5
DASHBOARD_CACHE_TTL_SECONDS=1200

# Auth
AUTH_MODE=mock
SUPABASE_URL=http://localhost:54321
SUPABASE_JWKS_URL=http://localhost:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_PROJECT_REF=local

# Provider
PROVIDER_MODE=mock
GEMINI_DISCOVERY_API_KEY=
GEMINI_PROMPT_API_KEY=
GEMINI_GROUNDED_SEARCH_API_KEY=
GEMINI_ANALYSIS_API_KEY=
GEMINI_DISCOVERY_MODEL=gemini-4-31b
GEMINI_PROMPT_MODEL=gemini-4-31b
GEMINI_GROUNDED_SEARCH_MODEL=gemini-4-31b
GEMINI_ANALYSIS_MODEL=gemini-4-31b

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-anon-key

# Testing
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_visibility_test
TEST_REDIS_URL=redis://localhost:6379/1
